+
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include "util.h"
+
+int
+main(int argc, char **argv)
+{
+	char *str_out = NULL;
+
+	if (argc <= 1) {
+		fprintf(stderr, "Usage: %s <some string>\n", argv[0]);
+		exit(1);
+	}
+
+	fprintf(stderr, "MUST PASS:\n");
+	fprintf(stderr, "argv[1]       @%#p\n", argv[1]);
+	fprintf(stderr, "argv[1]       \"%s\"\n", argv[1]);
+	
+	fprintf(stderr, "EXECUTE -> MUST PASS\n");
+	stack_alloc_strcpy(&str_out, argv[1]);
+
+	fprintf(stderr, "MUST PASS:\n");
+	fprintf(stderr, "str_out       @%#p\n", str_out);
+	fprintf(stderr, "MUST FAIL BUT DOES NOT!:\n");
+	fprintf(stderr, "str_out       \"%s\"\n", str_out);
+	
+	fprintf(stderr, "done.\n");
+
+	return 0;
+}
diff --git a/usr.bin/cheri_test_stackalloc/util.c b/usr.bin/cheri_test_stackalloc/util.c
new file mode 100644
index 000000000000..acd7b9653143
--- /dev/null
+++ b/usr.bin/cheri_test_stackalloc/util.c
@@ -0,0 +1,24 @@
+#include <stdio.h>
+#include <string.h>
+
+#include "util.h"
+
+#define HEAP_STR_SIZE 30
+
+void stack_alloc_strcpy(char **str_out, char *str_in) {
+	char str_on_stack[HEAP_STR_SIZE];
+
+	strncpy(str_on_stack, str_in, HEAP_STR_SIZE);
+
+	// this is a bug -> return stack allocated object
+	*str_out = (char*)str_on_stack;
+
+	fprintf(stderr, "MUST PASS:\n");
+	fprintf(stderr, "str_in        @%#p\n", str_in);
+	fprintf(stderr, "str_in        \"%s\"\n", str_in);
+	fprintf(stderr, "str_on_stack  @%#p\n", str_on_stack);
+	fprintf(stderr, "str_on_stack  \"%s\"\n", str_on_stack);
+	fprintf(stderr, "str_out       @%#p\n", str_out);
+	fprintf(stderr, "*str_out      @%#p\n", *str_out);
+	fprintf(stderr, "*str_out      \"%s\"\n", *str_out);
+}
