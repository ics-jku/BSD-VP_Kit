+
+#include <stdio.h>
+#include <string.h>
+
+int
+main(int argc, char **argv)
+{
+	int i;
+
+	printf("argc %i\n", argc);
+	for (i = 0; i < argc + 10; i++) {
+		if (i >= argc) {
+			printf("access element after end -> should cause exception?\n");
+		}
+		printf("argv[%i]: %s (len %lu)\n", i, argv[i], strlen(argv[i]));
+	}
+
+	int idx = argc - 1;
+	char *str = argv[idx];
+	int len = strlen(str);
+	printf("access argv[%i]\n", idx); 
+	for (i = 0; i < len + 10; i++) {
+		if (i >= len) {
+			printf("access element after end -> should cause exception?\n");
+		}
+		printf("argv[%i][%i]: %c\n", idx, i, str[i]);
+	}
+
+	printf("done.\n");
+
+	return 0;
+}
