new file mode 100644
--- /dev/null
+++ b/tools/build/cross-build/include/linux/memory
@@ -0,0 +1,12 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+#pragma once
+
+/*
+ * GCC 15's C++ headers can include glibc pthread internals with fields named
+ * __unused.  Keep FreeBSD's __unused macro from rewriting those field names.
+ */
+#include "__unused_workaround_start.h"
+#include_next <memory>
+#include "__unused_workaround_end.h"
